{%- comment -%}
  Renders Organization, OnlineStore and WebSite Schema.org JSON-LD
  Optimized for Google Rich Results, Local Search (Chile) and AI Answer Engines (AEO / GEO)
{%- endcomment -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "ClothingStore",
      "@id": "{{ shop.url }}/#clothingstore",
      "name": "Fiavelle",
      "legalName": "Fiavelle SpA",
      "url": "{{ shop.url }}",
      "logo": {
        "@type": "ImageObject",
        "@id": "{{ shop.url }}/#logo",
        "url": "{{ 'logo.svg' | asset_url | prepend: 'https:' }}",
        "caption": "Fiavelle"
      },
      "image": "{{ 'logo.svg' | asset_url | prepend: 'https:' }}",
      "description": "Tienda online de lencería femenina exclusiva en Chile. Conjuntos a medida con combinación de tallas de top y calzón, batas y babydolls con despacho a todo el país.",
      "telephone": "+56941944494",
      "email": "contacto@fiavelle.cl",
      "address": {
        "@type": "PostalAddress",
        "addressCountry": "CL",
        "addressRegion": "Región Metropolitana",
        "addressLocality": "Santiago"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": -33.4489,
        "longitude": -70.6693
      },
      "hasMap": "https://maps.google.com/?q=Santiago,Chile",
      "areaServed": {
        "@type": "Country",
        "name": "Chile"
      },
      "priceRange": "$$",
      "currenciesAccepted": "CLP",
      "paymentAccepted": "Credit Card, Debit Card, Mercado Pago, Transferencia Bancaria",
      "openingHoursSpecification": [
        {
          "@type": "OpeningHoursSpecification",
          "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"],
          "opens": "00:00",
          "closes": "23:59"
        }
      ],
      "contactPoint": {
        "@type": "ContactPoint",
        "telephone": "+56941944494",
        "contactType": "customer service",
        "availableLanguage": ["Spanish"]
      },
      "sameAs": [
        "https://www.instagram.com/fiavelle.cl",
        "https://wa.me/56941944494"
      ]
    },
    {
      "@type": "WebSite",
      "@id": "{{ shop.url }}/#website",
      "url": "{{ shop.url }}",
      "name": "Fiavelle",
      "description": "Lencería Femenina Exclusiva en Chile",
      "publisher": {
        "@id": "{{ shop.url }}/#organization"
      },
      "inLanguage": "{{ request.locale.iso_code }}",
      "potentialAction": {
        "@type": "SearchAction",
        "target": {
          "@type": "EntryPoint",
          "urlTemplate": "{{ shop.url }}/search?q={search_term_string}"
        },
        "query-input": "required name=search_term_string"
      }
    }
  ]
}
</script>
