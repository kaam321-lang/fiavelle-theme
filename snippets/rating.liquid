{% comment %}
  Renders rating component
  Accepts:
  - rating_value: {Number} Decimal or integer rating value (e.g. 4.5)
  - rating_max: {Number} Max scale value (default: 5)
  - rating_decimal: {Number} Decimal part (0, 0.5, 1)
  - reviews_count: {Number} Total count of reviews
{% endcomment %}

{%- liquid
  assign value = rating_value | default: 0 | round: 1
  assign max = rating_max | default: 5
  assign count = reviews_count | default: 0
-%}

{%- if count > 0 or value > 0 -%}
  <div class="rating" role="img" aria-label="{{ 'accessibility.star_reviews_info' | t: rating_value: value, rating_max: max }}">
    <span aria-hidden="true" class="rating-star color-icon-{{ settings.accent_icons }}" style="--rating: {{ value }}; --rating-max: {{ max }}; --rating-decimal: {{ rating_decimal | default: 0 }};"></span>
    <p class="rating-text caption">
      <span aria-hidden="true">{{ value }} / {{ max }}</span>
    </p>
    <p class="rating-count caption">
      <span aria-hidden="true">({{ count }})</span>
      <span class="visually-hidden">{{ count }} {{ 'accessibility.total_reviews' | t }}</span>
    </p>
  </div>
{%- endif -%}
