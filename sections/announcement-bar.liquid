{% comment %}
  Announcement Bar Section - Fiavelle Theme
{% endcomment %}

<div class="announcement-bar color-{{ section.settings.color_scheme }} gradient" id="AnnouncementBar" role="region" aria-label="{{ 'sections.header.announcement' | t }}">
  <div class="announcement-bar__content page-width" style="display: flex; align-items: center; justify-content: center; text-align: center;">
    <p class="announcement-bar__message h5" style="margin: 0; font-family: 'Poppins', sans-serif; font-size: 1.2rem; font-weight: 500; letter-spacing: 0.04em;">
      ✨ <strong style="text-transform: uppercase; color: #e793a9;">¡Crea tu propio conjunto!</strong> Mezcla la talla de top y calzón/colaless a tu medida &nbsp;|&nbsp; 🚚 ENVÍO GRATIS SOBRE $60.000
    </p>
  </div>
</div>

{% schema %}
{
  "name": "Barra de Anuncios",
  "tag": "section",
  "class": "section-announcement-bar",
  "settings": [
    {
      "type": "text",
      "id": "text",
      "default": "ENVÍO GRATIS EN COMPRAS SOBRE $50.000",
      "label": "Texto del anuncio"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Enlace del anuncio"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Esquema de color",
      "default": "background-1"
    }
  ],
  "presets": [
    {
      "name": "Barra de Anuncios"
    }
  ]
}
{% endschema %}
