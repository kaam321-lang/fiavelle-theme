{% comment %}
  Footer Section - Fiavelle Theme
  Dark footer #121212 with 4 columns: brand + 3 link columns
{% endcomment %}

<footer class="footer color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding" role="contentinfo">
  <div class="footer__content-top page-width">
    <div class="footer__columns">

      <!-- Brand Column -->
      <div class="footer__col footer__col--brand">
        <div class="footer__brand">
          {%- if section.settings.logo != blank -%}
            <a href="{{ routes.root_url }}" class="footer__logo-link">
              {{
                section.settings.logo
                | image_url: width: 200
                | image_tag:
                  loading: 'lazy',
                  class: 'footer__logo',
                  alt: shop.name | escape,
                  widths: '50, 100, 150, 200',
                  width: 150,
                  height: 50
              }}
            </a>
          {%- else -%}
            <a href="{{ routes.root_url }}" class="footer__brand-name h3">{{ shop.name }}</a>
          {%- endif -%}

          {%- if section.settings.brand_description != blank -%}
            <p class="footer__brand-description">{{ section.settings.brand_description | escape }}</p>
          {%- endif -%}
        </div>

        {%- if section.settings.newsletter_enable -%}
          <div class="footer__newsletter">
            {%- if section.settings.newsletter_heading != blank -%}
              <h3 class="footer__newsletter-heading">{{ section.settings.newsletter_heading | escape }}</h3>
            {%- endif -%}
            {% form 'customer', id: 'ContactFooter', class: 'footer__newsletter-form' %}
              <input type="hidden" name="contact[tags]" value="newsletter">
              <div class="field">
                <input
                  id="NewsletterForm--{{ section.id }}"
                  type="email"
                  name="contact[email]"
                  class="field__input"
                  value="{{ form.email }}"
                  aria-required="true"
                  autocorrect="off"
                  autocapitalize="off"
                  autocomplete="email"
                  placeholder="{{ 'newsletter.label' | t }}"
                  required
                >
                <label class="field__label" for="NewsletterForm--{{ section.id }}">
                  {{ 'newsletter.label' | t }}
                </label>
                <button type="submit" class="field__button btn btn--primary" name="commit" id="Subscribe">
                  <span>{{ 'newsletter.button_label' | t }}</span>
                </button>
              </div>
              {%- if form.errors -%}
                <small class="newsletter-form__message form__message" id="Newsletter-error--{{ section.id }}">
                  {% render 'icon-error' %}
                  {{ form.errors.translated_fields['email'] | capitalize }} {{ form.errors.messages['email'] }}
                </small>
              {%- endif -%}
              {%- if form.posted_successfully? -%}
                <h3 class="newsletter-form__message newsletter-form__message--success form__message">
                  {{ 'newsletter.success' | t }}
                </h3>
              {%- endif -%}
            {% endform %}
          </div>
        {%- endif -%}

        <!-- Social Links -->
        <div class="footer__social">
          {%- if section.settings.social_instagram_link != blank -%}
            <a href="{{ section.settings.social_instagram_link }}" class="footer__social-link" target="_blank" rel="noopener noreferrer" aria-label="Instagram">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
                <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
                <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
              </svg>
            </a>
          {%- endif -%}
          {%- if section.settings.social_tiktok_link != blank -%}
            <a href="{{ section.settings.social_tiktok_link }}" class="footer__social-link" target="_blank" rel="noopener noreferrer" aria-label="TikTok">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                <path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-2.88 2.5 2.89 2.89 0 0 1-2.89-2.89 2.89 2.89 0 0 1 2.89-2.89c.28 0 .54.04.79.1V9.01a6.32 6.32 0 0 0-.79-.05 6.34 6.34 0 0 0-6.34 6.34 6.34 6.34 0 0 0 6.34 6.34 6.34 6.34 0 0 0 6.33-6.34V8.69a8.25 8.25 0 0 0 4.83 1.56V6.78a4.86 4.86 0 0 1-1.06-.09z"/>
              </svg>
            </a>
          {%- endif -%}
        </div>
      </div>

      <!-- Link Columns (blocks) -->
      {%- for block in section.blocks -%}
        {%- if block.type == 'link_list' -%}
          <div class="footer__col footer__col--links" {{ block.shopify_attributes }}>
            {%- if block.settings.heading != blank -%}
              <h4 class="footer__heading">{{ block.settings.heading | escape }}</h4>
            {%- endif -%}
            {%- if block.settings.menu != blank -%}
              <ul class="footer__list list-unstyled" role="list">
                {%- for link in linklists[block.settings.menu].links -%}
                  <li class="footer__list-item">
                    <a href="{{ link.url }}" class="footer__link link">
                      {{ link.title | escape }}
                    </a>
                  </li>
                {%- endfor -%}
              </ul>
            {%- endif -%}
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>

  <div class="footer__content-bottom page-width">
    <div class="footer__bottom-row">
      <small class="footer__copyright">
        &copy; {{ 'now' | date: '%Y' }}, {{ shop.name | link_to: routes.root_url }}. {{ 'general.password_page.powered_by_shopify_html' | t }}
      </small>
      <div class="footer__payment">
        {%- unless shop.enabled_payment_types == empty -%}
          <ul class="list list-inline" role="list">
            {%- for type in shop.enabled_payment_types -%}
              <li class="list-inline__item">
                {{ type | payment_type_svg_tag: class: 'icon icon--full-color payment-icon' }}
              </li>
            {%- endfor -%}
          </ul>
        {%- endunless -%}
      </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "tag": "section",
  "class": "footer",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo del footer"
    },
    {
      "type": "textarea",
      "id": "brand_description",
      "label": "Descripción de la marca",
      "default": "Lencería femenina de diseño exclusivo. Creada para celebrar tu feminidad."
    },
    {
      "type": "header",
      "content": "Newsletter"
    },
    {
      "type": "checkbox",
      "id": "newsletter_enable",
      "default": true,
      "label": "Activar suscripción"
    },
    {
      "type": "text",
      "id": "newsletter_heading",
      "default": "Suscríbete",
      "label": "Título newsletter"
    },
    {
      "type": "header",
      "content": "Redes Sociales"
    },
    {
      "type": "url",
      "id": "social_instagram_link",
      "label": "Instagram"
    },
    {
      "type": "url",
      "id": "social_tiktok_link",
      "label": "TikTok"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Esquema de color",
      "default": "background-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding superior",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding inferior",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "link_list",
      "name": "Menú de enlaces",
      "limit": 5,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "default": "Quick links",
          "label": "Título"
        },
        {
          "type": "link_list",
          "id": "menu",
          "default": "footer",
          "label": "Menú"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Footer",
      "blocks": [
        {
          "type": "link_list"
        }
      ]
    }
  ]
}
{% endschema %}
