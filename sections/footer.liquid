{% comment %}
  Footer Section - Fiavelle Theme
  Clean minimal footer #FFF8F8 (Rose White) with centered horizontal link menus,
  centered newsletter subscription, and brand alignment.
{% endcomment %}

<footer class="footer footer--custom color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding" role="contentinfo">
  <div class="footer__inner page-width">

    <!-- 1. Menú horizontal centrado (INFORMACIÓN) -->
    {%- assign footer_menu = linklists[section.settings.menu] -%}
    {%- if footer_menu.links != blank -%}
      <div class="footer__centered-menu">
        <ul class="footer__horizontal-list list-unstyled" role="list">
          {%- for link in footer_menu.links -%}
            {%- assign link_title_raw = link.title | escape | upcase -%}
            {%- assign link_title_clean = link_title_raw -%}
            {%- if link_title_raw == 'SEARCH' -%}
              {%- assign link_title_clean = 'BUSCAR' -%}
            {%- endif -%}
            <li class="footer__horizontal-item">
              <a href="{{ link.url }}" class="footer__horizontal-link link">
                {{ link_title_clean }}
              </a>
            </li>
          {%- endfor -%}
        </ul>
      </div>
    {%- endif -%}

    <!-- 2. Newsletter centrado -->
    {%- if section.settings.newsletter_enable -%}
      <div class="footer__centered-newsletter">
        {%- if section.settings.newsletter_heading != blank -%}
          <h3 class="footer__newsletter-heading">{{ section.settings.newsletter_heading | escape }}</h3>
        {%- endif -%}
        {% form 'customer', id: 'ContactFooter', class: 'footer__newsletter-form' %}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <div class="footer__newsletter-field">
            <input
              id="NewsletterForm--{{ section.id }}"
              type="email"
              name="contact[email]"
              class="footer__newsletter-input"
              value="{{ form.email }}"
              aria-required="true"
              autocorrect="off"
              autocapitalize="off"
              autocomplete="email"
              placeholder="Correo electrónico"
              required
            >
            <button type="submit" class="footer__newsletter-submit" name="commit" id="Subscribe" aria-label="Suscribirse">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </button>
          </div>
          {%- if form.errors -%}
            <small class="newsletter-form__message form__message error" id="Newsletter-error--{{ section.id }}">
              {% render 'icon-error' %}
              {{ form.errors.translated_fields['email'] | capitalize }} {{ form.errors.messages['email'] }}
            </small>
          {%- endif -%}
          {%- if form.posted_successfully? -%}
            <h3 class="newsletter-form__message newsletter-form__message--success form__message success">
              ¡Gracias por suscribirte!
            </h3>
          {%- endif -%}
        {% endform %}
      </div>
    {%- endif -%}

    <!-- 3. Fila inferior: Redes sociales, Copyright y Métodos de pago -->
    <div class="footer__bottom-custom">
      <div class="footer__bottom-left">
        <!-- Copyright -->
        <small class="footer__copyright">
          &copy; {{ 'now' | date: '%Y' }}, {{ shop.name | link_to: routes.root_url }} · Tecnología de Shopify
        </small>
        <!-- Enlaces Legales -->
        {%- assign legal_menu = linklists[section.settings.legal_menu] -%}
        {%- if legal_menu.links != blank -%}
          <span class="footer__divider">·</span>
          <div class="footer__legal-links">
            {%- for link in legal_menu.links -%}
              <a href="{{ link.url }}" class="footer__legal-link link">{{ link.title | escape }}</a>
              {%- unless forloop.last -%}<span class="footer__legal-divider">·</span>{%- endunless -%}
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      <div class="footer__bottom-center">
        <!-- Métodos de Pago -->
        <div class="footer__payment">
          {%- unless shop.enabled_payment_types == empty -%}
            <ul class="list list-inline" role="list">
              {%- for type in shop.enabled_payment_types -%}
                <li class="list-inline__item">
                  {{ type | payment_type_svg_tag: class: 'icon icon--full-color payment-icon' }}
                </li>
              {%- endfor -%}
            </ul>
          {%- endunless -%}
        </div>
      </div>

      <div class="footer__bottom-right">
        <!-- Redes Sociales -->
        <div class="footer__social-links">
          {%- if settings.social_facebook_link != blank -%}
            <a href="{{ settings.social_facebook_link }}" class="footer__social-icon" target="_blank" rel="noopener noreferrer" aria-label="Facebook">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path>
              </svg>
            </a>
          {%- endif -%}
          {%- if settings.social_instagram_link != blank -%}
            <a href="{{ settings.social_instagram_link }}" class="footer__social-icon" target="_blank" rel="noopener noreferrer" aria-label="Instagram">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
                <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
                <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
              </svg>
            </a>
          {%- endif -%}
        </div>
      </div>
    </div>

  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "tag": "section",
  "class": "footer",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "default": "footer",
      "label": "Menú principal (INFORMACIÓN)"
    },
    {
      "type": "link_list",
      "id": "legal_menu",
      "label": "Menú legal (Copyright)"
    },
    {
      "type": "header",
      "content": "Newsletter"
    },
    {
      "type": "checkbox",
      "id": "newsletter_enable",
      "default": true,
      "label": "Activar newsletter"
    },
    {
      "type": "text",
      "id": "newsletter_heading",
      "default": "¡Suscríbete a nuestra página!",
      "label": "Título newsletter"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Esquema de color",
      "default": "background-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding superior",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding inferior",
      "default": 24
    }
  ],
  "presets": [
    {
      "name": "Footer"
    }
  ]
}
{% endschema %}
