{% comment %}
  Header Section - Fiavelle Theme
  Sticky header with logo, navigation and icons
{% endcomment %}

<header class="header color-{{ section.settings.color_scheme }} gradient{% if section.settings.sticky_header_type == 'always' %} shopify-section-header-sticky{% endif %}" id="SiteHeader">
  <div class="header__inner page-width">

    <!-- Fila Superior: Búsqueda/Hamburguesa, Logo, Cuenta/Carrito -->
    <div class="header__top-row">
      <!-- Izquierda: Hamburguesa (móvil) + Búsqueda -->
      <div class="header__left-group">
        <!-- Mobile Hamburger -->
        <button
          class="header__icon header__icon--menu btn-hamburger"
          aria-controls="MobileMenuDrawer"
          aria-expanded="false"
          aria-label="{{ 'sections.header.menu' | t }}"
        >
          <span class="hamburger-line"></span>
          <span class="hamburger-line"></span>
          <span class="hamburger-line"></span>
        </button>

        <!-- Search -->
        <details-modal class="header__search">
          <details>
            <summary class="header__icon header__icon--search header__icon--summary link focus-inset" role="button" aria-haspopup="dialog">
              <span>
                <svg xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false" role="presentation" class="icon icon-search" fill="none" viewBox="0 0 18 19">
                  <path fill-rule="evenodd" clip-rule="evenodd" d="M11.03 11.68A5.784 5.784 0 112.85 3.5a5.784 5.784 0 018.18 8.18zm1.06 1.06l3.76 3.76-1.06 1.06-3.76-3.76 1.06-1.06z" fill="currentColor"/>
                </svg>
                <span class="visually-hidden">{{ 'general.search.search' | t }}</span>
              </span>
            </summary>
          </details>
        </details-modal>
      </div>

      <!-- Centro: Logo -->
      <div class="header__center-group">
        <a href="{{ routes.root_url }}" class="header__heading-link link link--text focus-inset" aria-label="{{ shop.name }}">
          <img
            src="{{ 'logo.svg' | asset_url }}"
            class="header__heading-logo"
            alt="{{ shop.name | escape }}"
            width="{{ section.settings.logo_width }}"
            height="60"
            loading="eager"
            style="max-width: {{ section.settings.logo_width }}px; height: auto; display: block;"
          >
        </a>
      </div>

      <!-- Derecha: Cuenta + Carrito -->
      <div class="header__right-group">
        <!-- Account -->
        {%- if shop.customer_accounts_enabled -%}
          <a
            href="{%- if customer -%}{{ routes.account_url }}{%- else -%}{{ routes.account_login_url }}{%- endif -%}"
            class="header__icon header__icon--account link focus-inset"
            aria-label="{{ 'customer.account.title' | t }}"
          >
            <svg xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false" role="presentation" class="icon icon-account" fill="none" viewBox="0 0 18 19">
              <path fill-rule="evenodd" clip-rule="evenodd" d="M6 4.5a3 3 0 116 0 3 3 0 01-6 0zm3-4a4 4 0 100 8 4 4 0 000-8zm5.58 12.15c1.12.82 1.83 2.24 1.92 4.35H1.5c.09-2.11.8-3.53 1.92-4.35C4.66 11.85 6.5 11.5 9 11.5s4.35.35 5.58 1.15zM9 10.5c-2.7 0-4.98.37-6.6 1.55C.79 13.23 0 15.01 0 17.5v1h18v-1c0-2.49-.79-4.27-2.4-5.45C13.98 10.87 11.7 10.5 9 10.5z" fill="currentColor"/>
            </svg>
          </a>
        {%- endif -%}

        <!-- Cart -->
        <a href="{{ routes.cart_url }}" class="header__icon header__icon--cart link focus-inset" id="cart-icon-bubble" aria-label="{{ 'sections.header.cart_count' | t: count: cart.item_count }}" role="button">
          <svg xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false" role="presentation" class="icon icon-cart" fill="none" viewBox="0 0 40 40">
            <path d="M25.425 28.248h-11.1a.875.875 0 01-.862-.728L11.36 14.02H9.25a.75.75 0 010-1.5h2.75a.75.75 0 01.738.622l.58 3.608h16.56a.75.75 0 01.73.924l-2.436 9.85a.875.875 0 01-.748.724z" fill="currentColor"/>
            <path d="M15.25 32a1.5 1.5 0 100-3 1.5 1.5 0 000 3zM24.25 32a1.5 1.5 0 100-3 1.5 1.5 0 000 3z" fill="currentColor"/>
          </svg>
          {%- if cart != empty -%}
            <div class="cart-count-bubble">
              {%- if cart.item_count < 100 -%}
                <span aria-hidden="true">{{ cart.item_count }}</span>
              {%- endif -%}
              <span class="visually-hidden">{{ 'sections.header.cart_count' | t: count: cart.item_count }}</span>
            </div>
          {%- endif -%}
        </a>
      </div>
    </div>

    <!-- Fila Inferior: Menú de Navegación (Visible en escritorio) -->
    <div class="header__bottom-row">
      <!-- Desktop Navigation -->
      <nav class="header__inline-menu" role="navigation" aria-label="{{ 'accessibility.menu' | t }}">
        <ul class="list-menu list-menu--inline" role="list">
          
          <!-- OFERTAS -->
          <li>
            <a href="/collections/last-chance" class="header__menu-item list-menu__item link link--text focus-inset">
              OFERTAS
            </a>
          </li>
          
          <!-- CONJUNTOS -->
          <li>
            <header-menu>
              <details id="Details-HeaderMenu-1">
                <summary id="HeaderMenu-conjuntos" class="header__menu-item list-menu__item link focus-inset">
                  <span>CONJUNTOS</span>
                  {% render 'icon-caret' %}
                </summary>
                <ul class="header__submenu list-menu motion-reduce global-media-settings" role="list">
                  <li><a href="/collections/conjuntos" class="header__menu-item list-menu__item link link--text focus-inset">Dos piezas</a></li>
                  <li><a href="/collections/conjuntos" class="header__menu-item list-menu__item link link--text focus-inset">Ligueros y arnés</a></li>
                  <li><a href="/collections/conjuntos" class="header__menu-item list-menu__item link link--text focus-inset" style="font-weight: 600;">Ver todos</a></li>
                </ul>
              </details>
            </header-menu>
          </li>
          
          <!-- BODYSUIT -->
          <li>
            <a href="/collections/bodysuit" class="header__menu-item list-menu__item link link--text focus-inset">
              BODYSUIT
            </a>
          </li>
          
          <!-- BABYDOLL Y BATAS -->
          <li>
            <header-menu>
              <details id="Details-HeaderMenu-3">
                <summary id="HeaderMenu-babydoll-batas" class="header__menu-item list-menu__item link focus-inset">
                  <span>BABYDOLL Y BATAS</span>
                  {% render 'icon-caret' %}
                </summary>
                <ul class="header__submenu list-menu motion-reduce global-media-settings" role="list">
                  <li><a href="/collections/babydoll" class="header__menu-item list-menu__item link link--text focus-inset">Babydoll</a></li>
                  <li><a href="/collections/batas" class="header__menu-item list-menu__item link link--text focus-inset">Batas</a></li>
                  <li><a href="/collections/pijamas" class="header__menu-item list-menu__item link link--text focus-inset">Pijamas</a></li>
                  <li><a href="/collections/all" class="header__menu-item list-menu__item link link--text focus-inset" style="font-weight: 600;">Ver todos</a></li>
                </ul>
              </details>
            </header-menu>
          </li>
          

          
          <!-- BRALETTE Y BUSTIER -->
          <li>
            <a href="/collections/bralette-y-bustier" class="header__menu-item list-menu__item link link--text focus-inset">
              BRALETTE Y BUSTIER
            </a>
          </li>
          
          <!-- BOTTOM -->
          <li>
            <a href="/collections/bottom" class="header__menu-item list-menu__item link link--text focus-inset">
              BOTTOM
            </a>
          </li>
          
          <!-- MEDIAS Y ACCESORIOS -->
          <li>
            <a href="/collections/accesorios" class="header__menu-item list-menu__item link link--text focus-inset">
              MEDIAS Y ACCESORIOS
            </a>
          </li>
          

          
          <!-- GIFTCARDS -->
          <li>
            <a href="/products/gift-card" class="header__menu-item list-menu__item link link--text focus-inset">
              GIFTCARDS
            </a>
          </li>
          
        </ul>
      </nav>
    </div>

  </div>
</header>

<!-- Mobile Menu Drawer -->
<div id="MobileMenuDrawer" class="mobile-menu-drawer" aria-hidden="true">
  <div class="mobile-menu-drawer__inner">
    <button class="mobile-menu-drawer__close btn-close-mobile" aria-label="Cerrar menú">
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>
    <nav class="mobile-menu-drawer__nav">
      <ul class="mobile-menu-list" style="list-style: none; padding-left: 20px; padding-top: 20px;">
        <li class="mobile-menu-item" style="margin-bottom: 15px;"><a href="/collections/last-chance" class="mobile-menu-link" style="font-weight: 600; text-transform: uppercase; font-size: 1.6rem; color: #454344; text-decoration: none;">OFERTAS</a></li>
        
        <li class="mobile-menu-item" style="margin-bottom: 15px;">
          <span class="mobile-menu-link" style="font-weight: 600; text-transform: uppercase; font-size: 1.6rem; color: #454344;">CONJUNTOS</span>
          <ul style="list-style: none; padding-left: 15px; margin: 5px 0 10px 0; border-left: 1px solid #aea5a4;">
            <li style="margin-bottom: 8px;"><a href="/collections/conjuntos" class="mobile-menu-link" style="font-size: 1.4rem; color: rgba(69, 67, 68, 0.8); text-decoration: none;">Dos piezas</a></li>
            <li style="margin-bottom: 8px;"><a href="/collections/conjuntos" class="mobile-menu-link" style="font-size: 1.4rem; color: rgba(69, 67, 68, 0.8); text-decoration: none;">Ligueros y arnés</a></li>
          </ul>
        </li>

        <li class="mobile-menu-item" style="margin-bottom: 15px;"><a href="/collections/bodysuit" class="mobile-menu-link" style="font-weight: 600; text-transform: uppercase; font-size: 1.6rem; color: #454344; text-decoration: none;">BODYSUIT</a></li>

        <li class="mobile-menu-item" style="margin-bottom: 15px;">
          <span class="mobile-menu-link" style="font-weight: 600; text-transform: uppercase; font-size: 1.6rem; color: #454344;">BABYDOLL Y BATAS</span>
          <ul style="list-style: none; padding-left: 15px; margin: 5px 0 10px 0; border-left: 1px solid #aea5a4;">
            <li style="margin-bottom: 8px;"><a href="/collections/babydoll" class="mobile-menu-link" style="font-size: 1.4rem; color: rgba(69, 67, 68, 0.8); text-decoration: none;">Babydoll</a></li>
            <li style="margin-bottom: 8px;"><a href="/collections/batas" class="mobile-menu-link" style="font-size: 1.4rem; color: rgba(69, 67, 68, 0.8); text-decoration: none;">Batas</a></li>
            <li style="margin-bottom: 8px;"><a href="/collections/pijamas" class="mobile-menu-link" style="font-size: 1.4rem; color: rgba(69, 67, 68, 0.8); text-decoration: none;">Pijamas</a></li>
          </ul>
        </li>



        <li class="mobile-menu-item" style="margin-bottom: 15px;"><a href="/collections/bralette-y-bustier" class="mobile-menu-link" style="font-weight: 600; text-transform: uppercase; font-size: 1.6rem; color: #454344; text-decoration: none;">BRALETTE Y BUSTIER</a></li>
        <li class="mobile-menu-item" style="margin-bottom: 15px;"><a href="/collections/bottom" class="mobile-menu-link" style="font-weight: 600; text-transform: uppercase; font-size: 1.6rem; color: #454344; text-decoration: none;">BOTTOM</a></li>
        <li class="mobile-menu-item" style="margin-bottom: 15px;"><a href="/collections/accesorios" class="mobile-menu-link" style="font-weight: 600; text-transform: uppercase; font-size: 1.6rem; color: #454344; text-decoration: none;">MEDIAS Y ACCESORIOS</a></li>

        <li class="mobile-menu-item" style="margin-bottom: 15px;"><a href="/products/gift-card" class="mobile-menu-link" style="font-weight: 600; text-transform: uppercase; font-size: 1.6rem; color: #454344; text-decoration: none;">GIFTCARDS</a></li>
      </ul>
    </nav>
  </div>
</div>
<div class="mobile-menu-overlay" id="MobileMenuOverlay"></div>

{% schema %}
{
  "name": "Header",
  "class": "section-header",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo de la marca"
    },
    {
      "type": "range",
      "id": "logo_width",
      "min": 50,
      "max": 300,
      "step": 10,
      "default": 150,
      "unit": "px",
      "label": "Ancho del logo"
    },
    {
      "type": "link_list",
      "id": "menu",
      "default": "main-menu",
      "label": "Menú de navegación"
    },
    {
      "type": "select",
      "id": "sticky_header_type",
      "options": [
        {
          "value": "none",
          "label": "Ninguno"
        },
        {
          "value": "always",
          "label": "Siempre visible"
        },
        {
          "value": "reduce-logo-size",
          "label": "Reducir logo al scrollear"
        }
      ],
      "default": "always",
      "label": "Tipo de header sticky"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Esquema de color",
      "default": "background-1"
    }
  ],
  "blocks": [],
  "presets": [
    {
      "name": "Header"
    }
  ]
}
{% endschema %}
