{% comment %}
  Value Propositions / Trust Badges Section - Fiavelle
{% endcomment %}
<div class="value-props-section" style="background-color: #fff8f8; border-top: 1px solid rgba(174, 165, 164, 0.2); border-bottom: 1px solid rgba(174, 165, 164, 0.2); padding: 40px 20px;">
  <div class="page-width" style="max-width: 1200px; margin: 0 auto;">
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 30px; text-align: center;">
      
      <div class="value-prop-item" style="display: flex; flex-direction: column; align-items: center; gap: 12px;">
        <div style="color: #454344; width: 44px; height: 44px; display: flex; align-items: center; justify-content: center; background: #f3e8ea; border-radius: 50%;">
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <rect x="1" y="3" width="15" height="13"></rect>
            <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon>
            <circle cx="5.5" cy="18.5" r="2.5"></circle>
            <circle cx="18.5" cy="18.5" r="2.5"></circle>
          </svg>
        </div>
        <h4 style="font-family: 'Poppins', sans-serif; font-size: 1.3rem; font-weight: 600; color: #454344; margin: 0; text-transform: uppercase; letter-spacing: 0.08em;">Despacho Express RM</h4>
        <p style="font-family: 'Poppins', sans-serif; font-size: 1.2rem; color: #777; margin: 0; line-height: 1.4;">Envíos en 24 a 48 hrs en Santiago. Envío gratis sobre $60.000</p>
      </div>

      <div class="value-prop-item" style="display: flex; flex-direction: column; align-items: center; gap: 12px;">
        <div style="color: #454344; width: 44px; height: 44px; display: flex; align-items: center; justify-content: center; background: #f3e8ea; border-radius: 50%;">
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
            <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
          </svg>
        </div>
        <h4 style="font-family: 'Poppins', sans-serif; font-size: 1.3rem; font-weight: 600; color: #454344; margin: 0; text-transform: uppercase; letter-spacing: 0.08em;">Pago 100% Seguro</h4>
        <p style="font-family: 'Poppins', sans-serif; font-size: 1.2rem; color: #777; margin: 0; line-height: 1.4;">Webpay, tarjetas de crédito/débito y transferencias directas</p>
      </div>

      <div class="value-prop-item" style="display: flex; flex-direction: column; align-items: center; gap: 12px;">
        <div style="color: #454344; width: 44px; height: 44px; display: flex; align-items: center; justify-content: center; background: #f3e8ea; border-radius: 50%;">
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="23 4 23 10 17 10"></polyline>
            <polyline points="1 20 1 14 7 14"></polyline>
            <path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"></path>
          </svg>
        </div>
        <h4 style="font-family: 'Poppins', sans-serif; font-size: 1.3rem; font-weight: 600; color: #454344; margin: 0; text-transform: uppercase; letter-spacing: 0.08em;">Garantía de Cambio</h4>
        <p style="font-family: 'Poppins', sans-serif; font-size: 1.2rem; color: #777; margin: 0; line-height: 1.4;">30 días para cambios en batas, bralettes y camisolas</p>
      </div>

      <div class="value-prop-item" style="display: flex; flex-direction: column; align-items: center; gap: 12px;">
        <div style="color: #454344; width: 44px; height: 44px; display: flex; align-items: center; justify-content: center; background: #f3e8ea; border-radius: 50%;">
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
          </svg>
        </div>
        <h4 style="font-family: 'Poppins', sans-serif; font-size: 1.3rem; font-weight: 600; color: #454344; margin: 0; text-transform: uppercase; letter-spacing: 0.08em;">Calidad Premium</h4>
        <p style="font-family: 'Poppins', sans-serif; font-size: 1.2rem; color: #777; margin: 0; line-height: 1.4;">Tejidos delicados de satín y encajes de alta finura</p>
      </div>

    </div>
  </div>
</div>

