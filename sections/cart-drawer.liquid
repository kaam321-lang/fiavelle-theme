{% comment %}
  Cart Drawer Section - Fiavelle Theme
  Slide-over from right with dark overlay
{% endcomment %}

<div id="CartDrawer" class="cart-drawer" aria-hidden="true" role="dialog" aria-modal="true" aria-label="{{ 'sections.cart.title' | t }}">
  <div class="cart-drawer__overlay" id="CartDrawerOverlay"></div>
  <div class="cart-drawer__inner">
    <!-- Drawer Header -->
    <div class="cart-drawer__header">
      <h2 class="cart-drawer__title">{{ 'sections.cart.title' | t }}</h2>
      <button
        class="cart-drawer__close btn-close-cart"
        aria-label="{{ 'accessibility.close' | t }}"
        id="CartDrawerClose"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>

    <!-- Drawer Body -->
    <div class="cart-drawer__body" id="CartDrawerBody">
      {%- if cart != empty -%}
        {%- for item in cart.items -%}
          <div class="cart-item" id="CartItem-{{ item.index | plus: 1 }}" data-index="{{ item.index | plus: 1 }}">
            <div class="cart-item__image-wrapper">
              {%- if item.image -%}
                <img src="{{ item.image | image_url: width: 300 }}" class="cart-item__image" alt="{{ item.image.alt | escape }}" loading="lazy" width="75" height="75">
              {%- endif -%}
            </div>
            <div class="cart-item__details">
              <p class="cart-item__vendor body-sm">{{ item.product.vendor }}</p>
              <a href="{{ item.url }}" class="cart-item__name h5 break">
                {{- item.product.title | escape -}}
              </a>
              <ul class="cart-item__options" aria-label="{{ 'customer.order.details' | t }}">
                {%- unless item.product.has_only_default_variant -%}
                  {%- for option in item.options_with_values -%}
                    <li>
                      <span>{{ option.name }}: </span>{{ option.value }}
                    </li>
                  {%- endfor -%}
                {%- endunless -%}
              </ul>
              <div class="cart-item__quantity-wrapper">
                <div class="cart-item__quantity-controls">
                  <button
                    class="cart-item__quantity-btn quantity-btn-minus"
                    name="minus"
                    aria-label="{{ 'products.product.quantity.decrease' | t: product: item.product.title | escape }}"
                    data-index="{{ item.index | plus: 1 }}"
                  >−</button>
                  <input
                    class="cart-item__quantity-input"
                    type="number"
                    name="updates[]"
                    value="{{ item.quantity }}"
                    min="0"
                    aria-label="{{ 'products.product.quantity.input_label' | t: product: item.product.title | escape }}"
                    id="Drawer-quantity-{{ item.index | plus: 1 }}"
                    data-index="{{ item.index | plus: 1 }}"
                  >
                  <button
                    class="cart-item__quantity-btn quantity-btn-plus"
                    name="plus"
                    aria-label="{{ 'products.product.quantity.increase' | t: product: item.product.title | escape }}"
                    data-index="{{ item.index | plus: 1 }}"
                  >+</button>
                </div>
                <div class="cart-item__totals">
                  <div class="cart-item__price-wrapper">
                    {%- if item.original_price != item.final_price -%}
                      <span class="cart-item__discounted-prices">
                        <span class="visually-hidden">{{ 'products.product.price.sale_price' | t }}</span>
                        <span class="price price--end price--sale">{{ item.final_price | money }}</span>
                        <span class="visually-hidden">{{ 'products.product.price.regular_price' | t }}</span>
                        <span class="price price--end price--compare">{{ item.original_price | money }}</span>
                      </span>
                    {%- else -%}
                      <span class="price price--end">{{ item.original_price | money }}</span>
                    {%- endif -%}
                  </div>
                </div>
              </div>
            </div>
          </div>
        {%- endfor -%}
      {%- else -%}
        <div class="cart-drawer__empty">
          <svg xmlns="http://www.w3.org/2000/svg" class="cart-empty__icon" width="64" height="64" viewBox="0 0 40 40" fill="none">
            <path d="M25.425 28.248h-11.1a.875.875 0 01-.862-.728L11.36 14.02H9.25a.75.75 0 010-1.5h2.75a.75.75 0 01.738.622l.58 3.608h16.56a.75.75 0 01.73.924l-2.436 9.85a.875.875 0 01-.748.724z" fill="currentColor"/>
            <path d="M15.25 32a1.5 1.5 0 100-3 1.5 1.5 0 000 3zM24.25 32a1.5 1.5 0 100-3 1.5 1.5 0 000 3z" fill="currentColor"/>
          </svg>
          <p class="cart-drawer__empty-text">{{ 'sections.cart.empty' | t }}</p>
          <a href="{{ routes.all_products_collection_url }}" class="btn btn--primary" tabindex="-1">
            {{ 'general.continue_shopping' | t }}
          </a>
        </div>
      {%- endif -%}
    </div>

    <!-- Drawer Footer -->
    {%- if cart != empty -%}
      <div class="cart-drawer__footer">
        <div class="cart-drawer__subtotal">
          <span class="cart-drawer__subtotal-label">{{ 'sections.cart.subtotal' | t }}</span>
          <span class="cart-drawer__subtotal-value">{{ cart.total_price | money_with_currency }}</span>
        </div>
        <p class="cart-drawer__taxes-note body-sm">{{ 'sections.cart.taxes_and_shipping_policy_at_checkout_html' | t: link: shop.privacy_policy.url }}</p>
        <div class="cart-drawer__ctas">
          <a href="{{ routes.checkout_url }}" class="btn btn--primary btn--full-width cart-drawer__checkout" id="CartDrawerCheckout">
            {{ 'sections.cart.checkout' | t }}
          </a>
        </div>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Carrito Lateral",
  "tag": "section",
  "class": "cart-drawer-section",
  "settings": [],
  "presets": [
    {
      "name": "Carrito Lateral"
    }
  ]
}
{% endschema %}
