<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="#121212">

    <link rel="canonical" href="{{ canonical_url }}">

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}

    <title>{{ shop.name }} &ndash; Acceso Exclusivo</title>

    {% if page_description %}
      <meta name="description" content="{{ page_description | escape }}">
    {% endif %}

    {{ content_for_header }}

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <!-- Custom Brand Typography -->
    <style>
      @font-face {
        font-family: 'Collection Morning';
        src: url('{{ "CollectionMorning.otf" | asset_url }}') format('opentype');
        font-weight: 400;
        font-style: normal;
        font-display: swap;
      }

      :root {
        --color-bg: #fbf9f6;
        --color-card: #ffffff;
        --color-text: #121212;
        --color-accent: #c49a6c;
        --color-border: #e8e4df;
      }

      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      body {
        font-family: 'Poppins', sans-serif;
        background-color: var(--color-bg);
        color: var(--color-text);
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        align-items: center;
        padding: 40px 20px;
        background-image: radial-gradient(#e2ded8 1px, transparent 1px);
        background-size: 24px 24px;
      }

      .password-container {
        width: 100%;
        max-width: 460px;
        margin: auto;
        background: var(--color-card);
        padding: 48px 36px;
        border-radius: 12px;
        box-shadow: 0 10px 40px rgba(0, 0, 0, 0.06);
        border: 1px solid var(--color-border);
        text-align: center;
      }

      .password-logo {
        margin-bottom: 20px;
      }

      .password-logo-text {
        font-family: 'Collection Morning', serif;
        font-size: 40px;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: #121212;
        margin-bottom: 6px;
      }

      .password-subtitle {
        font-size: 12px;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: #888888;
        margin-bottom: 24px;
      }

      .password-message {
        font-size: 14px;
        color: #555555;
        line-height: 1.6;
        margin-bottom: 24px;
      }

      .password-form {
        display: flex;
        flex-direction: column;
        gap: 14px;
        margin-bottom: 24px;
      }

      .password-input-wrapper {
        position: relative;
        width: 100%;
      }

      .password-input {
        width: 100%;
        padding: 14px 18px;
        font-size: 14px;
        font-family: 'Poppins', sans-serif;
        border: 1px solid #d4cecb;
        border-radius: 6px;
        outline: none;
        transition: border-color 0.2s, box-shadow 0.2s;
        text-align: center;
        letter-spacing: 0.05em;
      }

      .password-input:focus {
        border-color: #121212;
        box-shadow: 0 0 0 3px rgba(18, 18, 18, 0.08);
      }

      .password-submit-btn {
        width: 100%;
        padding: 15px;
        background-color: #121212;
        color: #ffffff;
        font-family: 'Poppins', sans-serif;
        font-size: 13px;
        font-weight: 600;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        border: none;
        border-radius: 6px;
        cursor: pointer;
        transition: background-color 0.2s, transform 0.1s;
      }

      .password-submit-btn:hover {
        background-color: #2b2b2b;
      }

      .password-submit-btn:active {
        transform: scale(0.99);
      }

      .password-error {
        background-color: #fde8e8;
        color: #9b1c1c;
        padding: 10px 14px;
        border-radius: 6px;
        font-size: 13px;
        margin-bottom: 16px;
      }

      .password-footer-links {
        margin-top: 24px;
        padding-top: 20px;
        border-top: 1px solid #f0edea;
        display: flex;
        flex-direction: column;
        gap: 10px;
        font-size: 12px;
        color: #777777;
      }

      .password-footer-links a {
        color: #121212;
        text-decoration: none;
        font-weight: 500;
        transition: opacity 0.2s;
      }

      .password-footer-links a:hover {
        opacity: 0.7;
      }

      .password-copyright {
        margin-top: 24px;
        font-size: 12px;
        color: #999999;
        letter-spacing: 0.04em;
      }
    </style>
  </head>

  <body>
    <div class="password-container">
      <div class="password-logo">
        <h1 class="password-logo-text">Fiavelle</h1>
        <div class="password-subtitle">Lingerie & Haute Couture</div>
      </div>

      <p class="password-message">
        Nuestra tienda se encuentra actualmente en preparación exclusiva. Ingresa con tu contraseña de acceso:
      </p>

      {%- form 'storefront_password', class: 'password-form' -%}
        {%- if form.errors -%}
          <div class="password-error">
            Contraseña incorrecta. Por favor inténtalo nuevamente.
          </div>
        {%- endif -%}

        <div class="password-input-wrapper">
          <input
            type="password"
            name="password"
            id="Password"
            class="password-input"
            placeholder="Ingresa la contraseña"
            autocomplete="current-password"
            autofocus
            required
          >
        </div>

        <button type="submit" name="commit" class="password-submit-btn">
          Entrar a la tienda
        </button>
      {%- endform -%}

      <div class="password-footer-links">
        <div>¿Necesitas acceso o tienes dudas?</div>
        <a href="https://wa.me/56941944494?text=%C2%A1Hola%20Fiavelle!%20Quisiera%20consultar%20por%20la%20contrase%C3%B1a%20de%20acceso%20a%20la%20tienda.%20%F0%9F%8C%B8" target="_blank" rel="noopener noreferrer">
          Contactar por WhatsApp (+56 9 4194 4494)
        </a>
      </div>
    </div>

    <div class="password-copyright">
      &copy; {{ 'now' | date: '%Y' }} Fiavelle. Todos los derechos reservados.
    </div>

    <script src="{{ 'whatsapp.js' | asset_url }}" defer="defer"></script>
  </body>
</html>
